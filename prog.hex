// Sample picoRISC program
// n = 8 bits, Isize = 12+n = 20 bits
// format: 4b opcode, 4b %s, 4b %d, 8b immediate or address
//x'=-1*y=-y+(n-1)=15-y
//y'=*x
// HEX /////////// BINARY /////////////// ASSEMBLER ///////////////////////
10110    // 20'b0001 0000 0001 00010000;  # ADDI %0, %1, 16;     # 加载宽度到 %1=16                     //0
10210    // 20'b0001 0000 0010 00010000;  # ADDI %0, %2, 16;     # 加载高度到 %2=16                     //1
10300    // 20'b0001 0000 0011 00000000;  # ADDI %0, %3, 0;      # 初始化ROM地址指针 %3 = 0                //2
10400    //20'b0001 0000 0100 00000000;  # ADDI %0, %4, 0;    # 初始Y地址存入 %4（初始化 %4 地址）             //3
10500    //20'b0001 0000 0101 00000000;  # ADDI %0, %5, 0;    # 初始X地址存入 %5（初始化 %5 地址）LOOP_Y        //4
33600    // 20'b0011 0011 0110 00000000;  # LW %3, %6, -;        # 从ROM中读取数据到 %6，ROM地址在 %3loop_x      //5
8480F    // 20'b1000 0100 1000 00001111;  # SUB  %4, %8, 15;   # x' = 15-y，存入 %8                              //6
25901    // 20'b0010 0101 1001 00000001;  # MULI  %5, %9, 1;  # y' = x，计算 y'，存入 %9                   //7
29910    // 20'b0010 1001 1001 00010000;  # MULI %9, %9, 16; # y' = y' * 16，存入 %9                          //8
78900    // 20'b0111 1000 1001 00000000;  # ADD  %9, %9, %8; # addr = y' * 16 + x'，存入 %9                //9
13301    // 20'b0001 0011 0011 00000001;  # ADDI %3, %3, 1;    # 更新ROM地址指针，加1，指向下一个像素                //10
69600    // 20'b0110 1001 0110 00000000;  # STORE %9, %6, -;   # 将处理后的数据存储到 RAM 中，地址由 %9 指定          //11
15501    // 20'b0001 0101 0101 00000001;  # ADDI %5, %5, 1;    # 更新 x 方向地址指针，加1                      //12
45105    // 20'b0100 0101 0001 00000101;  # BLT  %5, %1, 5,loop_x; # if x<16,branch to loop_x                //13
14401    // 20'b0001 0100 0100 00000001;  # ADDI %4, %4, 1;    # 更新 y 方向地址指针，加1                     //14
44204    // 20'b0100 0100 0010 00000100;  # BLT  %4, %2, LOOP_Y; # if y<16,branch to loop_y                //15
50000    // 20'b0101 0000 0000 00000000;  FINISH %-, %-, 0; # 结果                                    //16

